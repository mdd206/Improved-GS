{
  "data_root": "/kaggle/working/vai_cleaned_no_p1/public_set",
  "output_root": "/kaggle/working/vai_models/pose_aware_60k_5m5/public_set",
  "repeat": 1,
  "python_executable": "python",
  "gpu_auto_select": false,
  "gpu_id": 0,
  "stop_on_error": true,
  "run_postprocess": true,
  "postprocess_script": "vai_render.py",
  "select_best_repeat_by_psnr": false,
  "checkpoint_args": {
    "checkpoint_iterations": [30000]
  },

  "train_args": {
    "training_method": "improvedgs",
    "iterations": 60000,
    "save_iterations": [30000, 45000, 60000],
    "position_lr_max_steps": 30000,
    "coarse_to_fine": true,
    "coarse_to_fine_middle_iter": 2000,
    "coarse_to_fine_full_iter": 5000,
    "pose_aware_sampling": true,
    "pose_aware_mode": "v1",
