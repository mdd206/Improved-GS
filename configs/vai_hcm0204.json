    "pose_aware_extra_fraction": 0.25,
    "pose_aware_max_repeat": 2,
    "densify_grad_threshold": 0.00020,
    "eval": false,
    "resolution": -1,
    "data_device": "cpu",
    "budget": 5500000,
    "progress_bar_width": 100,
    "report_lpips_test": false,
    "report_lpips_train": false
  },

  "postprocess_args": {
    "output_root": "/kaggle/working/vai_renders/pose_aware_60k_5m5/public_set",
    "eval_root": "/kaggle/working/vai_eval/pose_aware_60k_5m5/public_set",
    "output_extension": "csv",
    "save_png": true,
    "png_root": "/kaggle/working/vai_png/pose_aware_60k_5m5/public_set",
    "redistort_interpolation": "bicubic",
    "sharpen_amount": 1.0,
    "sharpen_sigma": 0.60,
    "jpeg_quality": 95,
    "jpeg_subsampling": 2,
    "evaluate": true,
    "require_gt": true,
    "overwrite": true,
    "psnr_max": 40.0,
    "lpips_net": "alex"
